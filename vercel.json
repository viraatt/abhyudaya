{
  "redirects": [
    {
      "source": "/blog/techbloom-2-0-at-mpec-igniting-curiosity-inspiring-innovation-and-shaping-tomorrows",
      "destination": "/blog/techbloom-20-at-mpec-igniting-curiosity-inspiring-innovation-and-shaping-tomorrows",
      "permanent": true
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.*\\.xml|feed\\.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/blog/write",
      "destination": "/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/index?blogSlug=:slug"
    },
    {
      "source": "/((?!blog(?:/|$)|.*\\.(?:png|jpg|jpeg|gif|svg|webp|avif|ico|css|js|mjs|json|woff|woff2|ttf|eot|mp4|webm|txt|xml|pdf)$).*)",
      "destination": "/index.html"
    }
  ]
}
