rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the authenticated user has an admin role.
    function isAdmin(roles) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // ============================================================
    // USERS (admin accounts)
    // Authenticated users can read their own record.
    // Only super_admin can manage users.
    // ============================================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin(['super_admin']);
    }

    // ============================================================
    // EVENTS
    // Public: read published events only.
    // Admins (super_admin, event_admin): read ALL + write.
    // ============================================================
    match /events/{eventId} {
      allow read: if isAdmin(['super_admin', 'event_admin'])
        || resource.data.status == 'Published';

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // ANNOUNCEMENTS
    // Public: read published announcements only.
    // Admins: read ALL + write.
    // ============================================================
    match /announcements/{announcementId} {
      allow read: if isAdmin(['super_admin', 'event_admin'])
        || resource.data.published == true;

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // STUDENTS
    // Admins only.
    // ============================================================
    match /students/{studentId} {
      allow read, create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // REGISTRATIONS
    // Public: CREATE only.
    // Admins: read/update/delete.
    // ============================================================
    match /registrations/{registrationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'eventId',
          'name',
          'email',
          'phone',
          'branch',
          'semester',
          'registrationId',
          'createdAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.registrationId is string
        && request.resource.data.registrationId.size() > 0
        && request.resource.data.createdAt is timestamp;

      allow read, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // BLOGS
    // Public: read published blogs only.
    // Admins: read ALL + write.
    // ============================================================
    match /blogs/{blogId} {
      allow read: if isAdmin(['super_admin', 'blog_admin'])
        || resource.data.status == 'Published';

      allow create, update, delete: if isAdmin(['super_admin', 'blog_admin']);
    }

    // ============================================================
    // BLOG COMMENTS
    // Public: read + create.
    // Admins: update/delete.
    // ============================================================
    match /blogs/{blogId}/comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name',
          'message',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;

      allow update, delete: if isAdmin(['super_admin', 'blog_admin']);
    }

    // ============================================================
    // TEAM
    // Public: read.
    // Admins: full CRUD.
    // ============================================================
    match /team/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin']);
    }

    // ============================================================
    // GALLERY
    // Public: read published albums only.
    // Admins (super_admin, event_admin, blog_admin): read ALL + write.
    // ============================================================
    match /gallery/{itemId} {
      allow read: if isAdmin(['super_admin', 'event_admin', 'blog_admin'])
        || resource.data.status == 'Published';

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin', 'blog_admin']);
    }

    // ============================================================
    // GALLERY META
    // Tracks permanently deleted static album IDs so they never
    // reappear from the STATIC_ALBUMS fallback.
    // Public: read (needed to filter deleted static albums).
    // Admins: read + write.
    // ============================================================
    match /gallery_meta/{metaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin', 'event_admin', 'blog_admin']);
    }

    // ============================================================
    // EVENT REVIEWS
    // Public: read approved reviews + submit review.
    // Admins: manage reviews.
    // ============================================================
    match /event_reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';

      allow create: if request.resource.data.keys().hasOnly([
        'eventId',
        'eventTitle',
        'eventSlug',
        'name',
        'email',
        'college',
        'branch',
        'profilePhoto',
        'rating',
        'title',
        'message',
        'status',
        'featured',
        'verifiedAttendee',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.eventId is string
      && request.resource.data.name is string
      && request.resource.data.rating is number;

      allow update, delete: if isAdmin(['super_admin']);
    }

    // ============================================================
    // MEDIA
    // Public: read.
    // Admins: full CRUD.
    // ============================================================
    match /media/{mediaId} {
      allow read: if true;

      allow create, update, delete:
        if isAdmin(['super_admin', 'blog_admin', 'event_admin']);
    }

    // ============================================================
    // CONTACT MESSAGES
    // Public: create.
    // Admins: read/update/delete.
    // ============================================================
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'subject',
        'message',
        'status',
        'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin(['super_admin']);
    }
  }
}