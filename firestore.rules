rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the authenticated user has an admin role.
    function isAdmin(roles) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function ownsAlumniArticle(data) {
      return request.auth != null
        && ((('authorUid' in data) && data.authorUid == request.auth.uid)
          || (('authorId' in data) && data.authorId == request.auth.uid));
    }

    function preservesAlumniOwner(before, after) {
      return after.get('authorUid', null) == before.get('authorUid', null)
        && after.get('authorId', null) == before.get('authorId', null);
    }

    function ownsLinkedAlumniBlog(blogId, blogData) {
      return request.auth != null
        && blogData.isAlumniContribution == true
        && blogData.submissionId is string
        && exists(/databases/$(database)/documents/alumniSubmissions/$(blogData.submissionId))
        && (get(/databases/$(database)/documents/alumniSubmissions/$(blogData.submissionId)).data.get('authorUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/alumniSubmissions/$(blogData.submissionId)).data.get('authorId', null) == request.auth.uid);
    }

    function linksToOwnedAlumniBlog(submissionId, blogId) {
      return blogId is string
        && exists(/databases/$(database)/documents/blogs/$(blogId))
        && get(/databases/$(database)/documents/blogs/$(blogId)).data.isAlumniContribution == true
        && get(/databases/$(database)/documents/blogs/$(blogId)).data.submissionId == submissionId;
    }

    // ============================================================
    // USERS (admin accounts)
    // Authenticated users can read their own record.
    // Only super_admin can manage users.
    // ============================================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin(['super_admin']);
    }

    // ============================================================
    // EVENTS
    // Public: read published events only.
    // Admins (super_admin, event_admin): read ALL + write.
    // ============================================================
    match /events/{eventId} {
      allow read: if isAdmin(['super_admin', 'event_admin'])
        || resource.data.status == 'Published';

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // ANNOUNCEMENTS
    // Public: read published announcements only.
    // Admins: read ALL + write.
    // ============================================================
    match /announcements/{announcementId} {
      allow read: if isAdmin(['super_admin', 'event_admin'])
        || resource.data.published == true
        || resource.data.status == 'published';

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // STUDENTS
    // Admins only.
    // ============================================================
    match /students/{studentId} {
      allow read, create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // REGISTRATIONS
    // Public submissions are validated and written through the server API using
    // the Firebase Admin SDK. Browser clients cannot read or forge records.
    // ============================================================
    match /registrations/{registrationId} {
      allow create: if false;

      // Clients cannot update payment/confirmation fields.
      // Only the trusted backend (Admin SDK) can set these.
      allow update: if isAdmin(['super_admin', 'event_admin']);

      allow read, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // BLOGS
    // Public: read published blogs only.
    // Super Admin: full create/update/delete including publishing alumni articles.
    // Blog Admin: can manage standard blogs, but CANNOT publish alumni articles.
    // Alumni can edit, unpublish, and delete only their own linked contributions.
    // ============================================================
    match /blogs/{blogId} {
      allow read: if isAdmin(['super_admin', 'blog_admin'])
        || resource.data.status == 'Published'
        || (isAdmin(['alumni'])
          && resource.data.isAlumniContribution == true
          && (ownsAlumniArticle(resource.data) || ownsLinkedAlumniBlog(blogId, resource.data)));

      // Only super_admin can create/update alumni contribution blogs
      // Blog Admin can manage regular blogs only
      allow create: if isAdmin(['super_admin'])
        || (isAdmin(['blog_admin']) && request.resource.data.isAlumniContribution != true);

      allow update: if isAdmin(['super_admin'])
        || (isAdmin(['blog_admin'])
          && resource.data.isAlumniContribution != true
          && request.resource.data.isAlumniContribution != true)
        || (isAdmin(['alumni'])
          && resource.data.isAlumniContribution == true
          && (ownsAlumniArticle(resource.data) || ownsLinkedAlumniBlog(blogId, resource.data))
          && request.resource.data.isAlumniContribution == true
          && request.resource.data.status == resource.data.status
          && preservesAlumniOwner(resource.data, request.resource.data)
          && request.resource.data.submissionId == resource.data.submissionId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'slug', 'category', 'featuredImage', 'tags', 'seo',
            'publishDate', 'author', 'alumniAuthor', 'excerpt', 'content', 'updatedAt'
          ]))
        || (isAdmin(['alumni'])
          && resource.data.isAlumniContribution == true
          && (ownsAlumniArticle(resource.data) || ownsLinkedAlumniBlog(blogId, resource.data))
          && resource.data.status == 'Published'
          && request.resource.data.status == 'Draft'
          && preservesAlumniOwner(resource.data, request.resource.data)
          && request.resource.data.submissionId == resource.data.submissionId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin(['super_admin', 'blog_admin'])
        || (isAdmin(['alumni'])
          && resource.data.isAlumniContribution == true
          && (ownsAlumniArticle(resource.data) || ownsLinkedAlumniBlog(blogId, resource.data)));
    }

    // ============================================================
    // ALUMNI ARTICLE SUBMISSIONS
    // Alumni can create/save Drafts and Submit for Approval (Pending).
    // Alumni CANNOT set status to 'Approved' or 'Published'.
    // Only Super Admin can approve, reject, or publish.
    // ============================================================
    match /alumniSubmissions/{submissionId} {
      allow read: if isAdmin(['super_admin', 'blog_admin'])
        || (isAdmin(['alumni'])
          && request.auth != null
          && resource.data.authorUid == request.auth.uid)
        || (isAdmin(['alumni'])
          && request.auth != null
          && resource.data.authorId == request.auth.uid)
        // Public article pages use the sanitized blogs document; keep private
        // submission details (including author email) out of authenticated reads.
        || (request.auth == null
          && (resource.data.status == 'published' || resource.data.status == 'approved'));

      allow create: if isAdmin(['super_admin', 'blog_admin'])
        || (isAdmin(['alumni'])
          && ownsAlumniArticle(request.resource.data)
          && (request.resource.data.status == 'draft' || request.resource.data.status == 'pending'));

      // Super Admin has full review/publish rights.
      // Blog Admin cannot approve or publish alumni submissions.
      // Alumni can only update their own drafts or when changes are requested.
      allow update: if isAdmin(['super_admin'])
        || (
          isAdmin(['blog_admin'])
          && request.resource.data.status != 'published'
          && request.resource.data.status != 'approved'
        )
        || (
          request.auth != null
          && isAdmin(['alumni'])
          && ownsAlumniArticle(resource.data)
          && (resource.data.status == 'draft' || resource.data.status == 'changes_requested')
          && (request.resource.data.status == 'draft' || request.resource.data.status == 'pending' || request.resource.data.status == 'resubmitted')
          && request.resource.data.status != 'published'
          && request.resource.data.status != 'approved'
        )
        // Alumni may edit their own already-published article while keeping it published.
        || (isAdmin(['alumni'])
          && ownsAlumniArticle(resource.data)
          && resource.data.status == 'published'
          && request.resource.data.status == 'published'
          && preservesAlumniOwner(resource.data, request.resource.data)
          && request.resource.data.publishedBlogId == resource.data.publishedBlogId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'slug', 'category', 'excerpt', 'content', 'featuredImage', 'tags',
            'author', 'alumniAuthor', 'authorEmail', 'authorProfilePhoto', 'updatedAt'
          ]))
        // After unpublishing, the owner can edit the approved article back into a draft.
        || (isAdmin(['alumni'])
          && ownsAlumniArticle(resource.data)
          && resource.data.status == 'approved'
          && request.resource.data.status == 'draft'
          && preservesAlumniOwner(resource.data, request.resource.data)
          && request.resource.data.publishedBlogId == resource.data.publishedBlogId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'title', 'slug', 'category', 'excerpt', 'content', 'featuredImage', 'tags',
            'author', 'alumniAuthor', 'authorEmail', 'authorProfilePhoto', 'updatedAt'
          ]))
        // Unpublishing is limited to the owning alumni contributor and this one status change.
        || (isAdmin(['alumni'])
          && ownsAlumniArticle(resource.data)
          && resource.data.status == 'published'
          && request.resource.data.status == 'approved'
          && preservesAlumniOwner(resource.data, request.resource.data)
          && (request.resource.data.publishedBlogId == resource.data.publishedBlogId
            || linksToOwnedAlumniBlog(submissionId, request.resource.data.publishedBlogId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'publishedBlogId']));

      allow delete: if isAdmin(['super_admin'])
        || (
          isAdmin(['alumni'])
          && ownsAlumniArticle(resource.data)
        );
    }

    // ============================================================
    // BLOG COMMENTS
    // Public: read + create.
    // Admins: update/delete.
    // ============================================================
    match /blogs/{blogId}/comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name',
          'message',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;

      allow update, delete: if isAdmin(['super_admin', 'blog_admin']);
    }

    // ============================================================
    // TEAM
    // Public: read.
    // Admins: full CRUD.
    // ============================================================
    match /team/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin']);
    }

    // ============================================================
    // GALLERY
    // Public: read published albums only.
    // Admins (super_admin, event_admin): read ALL + write.
    // ============================================================
    match /gallery/{itemId} {
      allow read: if isAdmin(['super_admin', 'event_admin'])
        || resource.data.status == 'Published';

      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // GALLERY META
    // Tracks permanently deleted static album IDs so they never
    // reappear from the STATIC_ALBUMS fallback.
    // Public: read (needed to filter deleted static albums).
    // Admins: read + write.
    // ============================================================
    match /gallery_meta/{metaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // EVENT REVIEWS
    // Public: read approved reviews + submit review.
    // Admins: manage reviews.
    // ============================================================
    match /event_reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';

      allow create: if request.resource.data.keys().hasOnly([
        'eventId',
        'eventTitle',
        'eventSlug',
        'name',
        'email',
        'college',
        'branch',
        'profilePhoto',
        'rating',
        'title',
        'message',
        'status',
        'featured',
        'verifiedAttendee',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.eventId is string
      && request.resource.data.name is string
      && request.resource.data.rating is number;

      allow update, delete: if isAdmin(['super_admin']);
    }

    // ============================================================
    // MEDIA
    // Public: read.
    // Admins: full CRUD.
    // ============================================================
    match /media/{mediaId} {
      allow read: if true;

      allow create, update, delete:
        if isAdmin(['super_admin', 'blog_admin', 'event_admin']);
    }

    // ============================================================
    // CONTACT MESSAGES
    // Public: create.
    // Admins: read/update/delete.
    // ============================================================
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'subject',
        'message',
        'status',
        'createdAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, update, delete: if isAdmin(['super_admin']);
    }

    // ============================================================
    // TIME CAPSULES
    // Public creation and opening are validated strictly through serverless
    // APIs using the Firebase Admin SDK. Browser clients cannot read,
    // create, update, or delete records directly.
    // Admins (super_admin, event_admin): read, update, delete.
    // ============================================================
    // ============================================================
    // CERTIFICATES
    // Public: read (for student verification and viewing).
    // Admins (super_admin, event_admin): create, update, delete.
    // ============================================================
    match /certificates/{certId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // CERTIFICATE TEMPLATES
    // Admins (super_admin, event_admin): full CRUD.
    // ============================================================
    match /certificateTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // CERTIFICATE JOBS (Bulk generation progress and logs)
    // Admins (super_admin, event_admin): full CRUD.
    // ============================================================
    match /certificateJobs/{jobId} {
      allow read, create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    // ============================================================
    // CERTIFICATES & GENERATOR
    // Public: read certificates for verification / search.
    // Admins (super_admin, event_admin): full CRUD.
    // ============================================================
    match /certificates/{certId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(['super_admin', 'event_admin']);
    }

    match /certificateTemplates/{templateId} {
      allow read, write: if isAdmin(['super_admin', 'event_admin']);
    }

    match /certificateJobs/{jobId} {
      allow read, write: if isAdmin(['super_admin', 'event_admin']);
    }

    match /certificateCounters/{counterId} {
      allow read, write: if isAdmin(['super_admin', 'event_admin']);
    }
  }
}

