# Abhyudaya Club — Example Environment Variables
# Copy this file to .env.local and configure your environment

# ── Cloudinary Configuration ──────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=abhyudaya_blog
VITE_CLOUDINARY_CERT_PRESET=abhyudaya_certs

# ── Firebase Web Configuration (Public) ──────────────────────
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Firebase Cloud Messaging (Web Push VAPID Key) ─────────────
# Generate in Firebase Console: Project Settings -> Cloud Messaging -> Web Push certificates -> Generate key pair
VITE_FIREBASE_VAPID_KEY=your_fcm_vapid_key_pair_here

# ── Razorpay (SERVER-SIDE ONLY — NEVER expose to browser) ─────
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase Admin (SERVER-SIDE ONLY) ─────────────────────────
# Path to service account JSON or raw JSON string for serverless deployment
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
